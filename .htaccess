# php_flag / php_value directives require mod_php and do not work with PHP-FPM (MAMP).
# Session cookie hardening (HttpOnly, SameSite, Secure) is handled at the PHP level (session_start() options).

# Force HTTPS on the production host only — local dev (MAMP/localhost) is unaffected.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?teepsaa\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# One canonical hostname. The HTTPS rule above keeps whatever host was typed,
# so without this www.teepsaa.com serves the whole catalogue alongside the
# apex while every canonical tag names the apex. Runs after it so a www+http
# request lands on https apex in two hops rather than looping.
RewriteCond %{HTTP_HOST} ^www\.teepsaa\.com$ [NC]
RewriteRule ^(.*)$ https://teepsaa.com/$1 [L,R=301]

# Sitemap under the name crawlers and SEO tools actually look for. The
# generator stays sitemap.php because it needs the DB.
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# robots.txt is generated so it can differ per host — all three subdomains
# share this document root, so a static file would hand vendor. and admin.
# the buyer site's crawl rules. See robots.php.
RewriteRule ^robots\.txt$ /robots.php [L]

# A styled 404 with the header, nav and a way back, instead of Apache's
# default grey page.
ErrorDocument 404 /404/index.php

# The home-screen app manifest (/admin/prospects/manifest.webmanifest) —
# Apache does not know this extension out of the box.
AddType application/manifest+json .webmanifest

# Block direct access to sensitive files (.md/.sql: checklists and DB
# schema are never meant to be served, even if a stray copy deploys)
<FilesMatch "^\.env|\.gitignore|\.htpasswd|\.user\.ini|\.log$|\.md$|\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Pre-launch gate ──────────────────────────────────────────────────
# Password-protects the whole site until launch. DELETE THIS BLOCK (and
# the .htpasswd file) TO GO LIVE.
#
# (Local dev is bypassed via LOCAL_DEV below, so MAMP is unaffected.)
SetEnvIf Host "^(localhost|127\.0\.0\.1)(:|$)" LOCAL_DEV
AuthType Basic
AuthName "teepsaa — coming soon"
AuthUserFile /home/u767733958/domains/teepsaa.com/public_html/.htpasswd
<RequireAny>
    Require env LOCAL_DEV
    Require valid-user
</RequireAny>
