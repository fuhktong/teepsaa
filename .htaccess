# php_flag / php_value directives require mod_php and do not work with PHP-FPM (MAMP).
# Session cookie hardening (HttpOnly, SameSite, Secure) is handled at the PHP level (session_start() options).

# Force HTTPS on the production host only — local dev (MAMP/localhost) is unaffected.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?teepsaa\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# One canonical hostname. The HTTPS rule above keeps whatever host was typed,
# so without this www.teepsaa.com serves the whole catalogue alongside the
# apex while every canonical tag names the apex. Runs after it so a www+http
# request lands on https apex in two hops rather than looping.
RewriteCond %{HTTP_HOST} ^www\.teepsaa\.com$ [NC]
RewriteRule ^(.*)$ https://teepsaa.com/$1 [L,R=301]

# Sitemap under the name crawlers and SEO tools actually look for. The
# generator stays sitemap.php because it needs the DB.
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# robots.txt is generated so it can differ per host — all three subdomains
# share this document root, so a static file would hand vendor. and admin.
# the buyer site's crawl rules. See robots.php.
RewriteRule ^robots\.txt$ /robots.php [L]

# ── Readable addresses ───────────────────────────────────────────────
# /product/silk-krama-scarf-8f14e45f-ab3c/  →  product/index.php
# /business/lucky-silk-3c1d9a77-2b4e/       →  business/index.php
# /category/dresses/                        →  category/index.php
#
# The slug is deliberately NOT passed as a query parameter. Slugs may contain
# Khmer, and pushing percent-encoded UTF-8 through a rewrite substitution is
# where that gets mangled; each page reads REQUEST_URI itself instead.
#
# !-f keeps the real files in those folders — product/product.css and the
# rest — serving themselves rather than being read as a slug. QSA preserves
# ?lang=en, which the whole English half of the site depends on.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^product/[^/]+/?$ /product/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^business/[^/]+/?$ /business/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^category/[^/]+/?$ /category/index.php [L,QSA]

# A styled 404 with the header, nav and a way back, instead of Apache's
# default grey page.
ErrorDocument 404 /404/index.php

# The home-screen app manifest (/admin/prospects/manifest.webmanifest) —
# Apache does not know this extension out of the box.
AddType application/manifest+json .webmanifest

# Block direct access to sensitive files (.md/.sql: checklists and DB
# schema are never meant to be served, even if a stray copy deploys)
<FilesMatch "^\.env|\.gitignore|\.htpasswd|\.user\.ini|\.log$|\.md$|\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Transfer size and browser caching ────────────────────────────────
# Without these every visitor re-downloads the logo, the two font files and
# every stylesheet on every page, and the HTML goes down the wire uncompressed.
# Both modules are standard on Hostinger/LiteSpeed; the IfModule wrappers make
# the whole block inert rather than a 500 if one is ever missing.

<IfModule mod_deflate.c>
    # Text only. Compressing a JPEG or WebP again spends CPU to make the file
    # slightly bigger, so images and fonts are deliberately absent here —
    # woff2 is already Brotli-compressed internally.
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        text/javascript application/javascript application/json \
        application/xml application/rss+xml image/svg+xml \
        application/manifest+json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Uploads and site images keep their filename forever, so a year is safe.
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon  "access plus 1 year"

    # Self-hosted subset fonts — these never change under the same name.
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff  "access plus 1 year"

    # CSS and JS are NOT versioned in this codebase (/style.css, /js/map.js),
    # so a long cache would strand returning visitors on the old stylesheet
    # after a deploy. A week is the compromise: repeat visits within a session
    # cost nothing, and a design change reaches everyone inside seven days.
    # Shorten this to a few hours while actively working on the CSS.
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType text/javascript       "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"

    # Every page is signed-in-sensitive (cart count, buyer name in the nav),
    # so HTML must never be cached — no default rule is set for that reason.
</IfModule>

# ── Pre-launch gate ──────────────────────────────────────────────────
# A Basic Auth prompt in front of all three hosts — teepsaa.com,
# vendor.teepsaa.com and admin.teepsaa.com — so no one sees the site before
# launch. On admin it also serves as the second lock on top of the admin login.
#
# Four things are let straight through, before the password rule is reached:
#   - localhost, so MAMP never prompts.
#   - /api/v1/, which the vendor and buyer apps call. They send their own
#     "Authorization: Bearer" header, which a Basic Auth prompt would reject,
#     so gating it would log every app user out with a 401.
#   - /uploads/, where every photo the apps show lives (products, banners,
#     avatars). An app's <img> can't answer a password prompt, so gated it
#     shows no pictures at all. Directory listing stays off, and the names
#     are random, so nothing there can be browsed.
#   - /api/order-photo.php, the dispatch and return photos. Same reason: the
#     apps show them in an <img>. The script has its own guard — the filename
#     is a 32-character random key (config/order-photo.php).
#
# The password file lives on the server and is never deployed (rsync
# excludes .htpasswd*; the FilesMatch rule above also stops it being
# served). If AuthUserFile points at a file that does not exist, every
# host returns 500. To create or change it:
#
#   ssh -t teepsaa 'read -rsp "New admin password: " p; echo; \
#     /opt/alt/php83/usr/bin/php -r "echo \"admin:\".password_hash(\$argv[1], PASSWORD_BCRYPT).PHP_EOL;" "$p" \
#     > ~/domains/teepsaa.com/public_html/.htpasswd-admin \
#     && chmod 644 ~/domains/teepsaa.com/public_html/.htpasswd-admin && echo created'
#
# 644, NOT 600. LiteSpeed's server core reads AuthUserFile as a different
# system user than PHP runs as, so a 600 file is unreadable to it and every
# login fails with no error anywhere — the browser just re-prompts forever.
# Verified 2026-09-09: same file, same password, 600 = 401 and 644 = 200.
# Leaving it world-readable is safe here: the FilesMatch rule above returns
# 403 for it (checked on both hosts) and it holds a bcrypt hash, not a
# password.
#
# AT LAUNCH: the public site must answer without a password, or Google
# indexes nothing. Put back the admin-only version — replace the four
# SetEnvIf lines for LOCAL_DEV, API_OPEN, UPLOADS_OPEN and PHOTO_OPEN with:
#   SetEnvIf Host "." NOT_ADMIN_HOST
#   SetEnvIf Host "^admin\.teepsaa\.com(:|$)" !NOT_ADMIN_HOST
# the four "Require env" lines with "Require env NOT_ADMIN_HOST", and delete
# the mod_headers block under them.
SetEnvIf Host "^(localhost|127\.0\.0\.1)(:|$)" LOCAL_DEV
SetEnvIf Request_URI "^/api/v1/" API_OPEN
SetEnvIf Request_URI "^/uploads/" UPLOADS_OPEN
SetEnvIf Request_URI "^/api/order-photo\.php$" PHOTO_OPEN
AuthType Basic
AuthName "teepsaa — coming soon"
AuthUserFile /home/u767733958/domains/teepsaa.com/public_html/.htpasswd-admin
<RequireAny>
    Require env LOCAL_DEV
    Require env API_OPEN
    Require env UPLOADS_OPEN
    Require env PHOTO_OPEN
    Require valid-user
</RequireAny>
# The server still stamps its Basic challenge onto the API's own JSON 401s
# (bad or expired token). A WebView can answer that with a password popup
# instead of letting the app see the 401 and send the user to its login.
<IfModule mod_headers.c>
    Header always unset WWW-Authenticate env=API_OPEN
</IfModule>
